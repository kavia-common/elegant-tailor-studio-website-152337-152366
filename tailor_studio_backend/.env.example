# Backend configuration example for Tailor Studio
# Copy this file to .env and fill in the values, or set via deployment environment

# Server
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database (use either MYSQL_URL or the discrete vars below)
# MYSQL_URL=mysql://user:password@host:3306/database

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DB=tailor_studio
